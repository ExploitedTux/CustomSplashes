{
  "schemaVersion": 1,
  "id": "customsplashes",
  "version": "${version}",
  "name": "Custom Splashes",
  "description": "A tiny client-side mod for custom title screen splash texts and a clean configuration screen.",
  "authors": [
    "ExploitedTux"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.exploitedtux.CustomSplashes"
    ],
    "client": [
      "com.exploitedtux.client.CustomSplashesClient"
    ]
  },
  "mixins": [
    "modid.mixins.json",
    {
      "config": "modid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}